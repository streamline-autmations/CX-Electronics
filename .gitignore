# ── Dependencies ─────────────────────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────────────────────
dist/
dist-ssr/
*.local

# ── Environment — never commit real credentials ──────────────────────
# `.env.example` is the committed template; everything else stays local.
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Python (catalogue tooling is kept outside this repo) ─────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── AI / agent tooling metadata (machine-local, not project config) ──
.claude/
.codex/
.agents/
.n8nac/
.bolt/
.kilocode/
.trae/
.aider*
.mcp.json

# ── Local data-migration working files (NOT application source) ──────
# Throwaway artifacts from catalogue / price / image / spec maintenance:
# DB snapshots, generated SQL, and CSV/JSON/HTML worklists. The long-lived
# copies live outside the repo in ../CX-Website-archive/.
*.csv
*.sql
*.xlsx
*_backup_*.json
*_review.html
*_apply.json
*_proposal.json
scripts/*.json
scripts/spec_in/
scripts/spec_out/
scripts/name_in/
scripts/name_out/
scripts/diff_in/
scripts/diff_out/

# One-off DB maintenance scripts (run locally with node, read .env.local)…
scripts/*.mjs
# …except the SEO generator, which runs as part of the Netlify build.
!scripts/generate-seo.mjs
