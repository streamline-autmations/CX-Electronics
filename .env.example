# CW Electronics — environment template.
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# WARNING: every VITE_-prefixed variable is inlined into the public browser
# bundle by Vite. Only put values here that are safe for customers to read.
# Server-only secrets (service-role keys, API secrets) belong in the Netlify
# dashboard or Supabase Edge Function secrets — never in a VITE_ variable.

# ── Supabase (required) ──────────────────────────────────────────────
# The anon key is publishable by design; row-level security is what protects data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── PayFast (only needed when the PayFast flow is re-enabled) ────────
# NOTE: the merchant key and passphrase must NOT stay VITE_-prefixed once
# PayFast goes live — signing has to move into the payfast-itn edge function.
VITE_PAYFAST_MERCHANT_ID=10000000
VITE_PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
VITE_PAYFAST_PASSPHRASE=your-payfast-passphrase
VITE_PAYFAST_SANDBOX=true

# ── Checkout behaviour ───────────────────────────────────────────────
# `true` shows the simulated payment step instead of the live gateway.
VITE_DEMO_CHECKOUT=false

# ── EFT banking details shown on checkout / invoices ─────────────────
# Optional: src/lib/banking.ts falls back to committed defaults if unset.
VITE_BANK_NAME=Your Bank
VITE_BANK_ACCOUNT_HOLDER=Your Company (Pty) Ltd
VITE_BANK_ACCOUNT_NUMBER=0000000000
VITE_BANK_BRANCH_CODE=000000
VITE_BANK_ACCOUNT_TYPE=Current

# ── Address autocomplete (checkout) ──────────────────────────────────
VITE_GEOAPIFY_API_KEY=your-geoapify-key

# ── n8n automation webhooks (optional; features degrade silently) ────
VITE_N8N_NEW_ORDER=https://your-n8n-host/webhook/new-order
VITE_N8N_STATUS_CHANGE=https://your-n8n-host/webhook/status-change
VITE_N8N_SIGNUP=https://your-n8n-host/webhook/signup
VITE_N8N_CONTACT=https://your-n8n-host/webhook/contact

# ── Cloudinary: new admin product-image uploads (unsigned preset) ────
# Unsigned uploads need only the cloud name + preset. Never ship the API secret.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# ── Client-side PWA install gate ─────────────────────────────────────
# Convenience only — this is visible in the bundle and is not a security control.
VITE_PWA_INSTALL_PASSWORD=change-me
